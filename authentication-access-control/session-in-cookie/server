def current_user():
    return request.cookies.get("session")


def address(username):
    return f"{username}@pwm.college"


@app.route("/login")
def login_page():
    return render_template("login.html", hide_chrome=True)


@app.route("/register")
def register_page():
    return render_template("register.html", hide_chrome=True)


@app.route("/api/auth/login", methods=["POST"])
def api_login():
    username = request.form.get("username")
    password = request.form.get("password")
    if not username or not password:
        flash("Enter your username and password")
        return redirect("/login")
    user = db.execute(
        "SELECT username FROM users WHERE username = ? AND password = ?",
        (username, password),
    ).fetchone()
    if not user:
        flash("Incorrect username or password")
        return redirect("/login")
    response = make_response(redirect("/"))
    response.set_cookie("session", user["username"])
    return response


@app.route("/api/auth/logout", methods=["POST"])
def api_logout():
    response = make_response("", 204)
    response.delete_cookie("session")
    return response


@app.route("/api/auth/register", methods=["POST"])
def api_register():
    username = (request.form.get("username") or "").strip()
    password = request.form.get("password") or ""
    if not username or not password:
        flash("Enter a username and password")
        return redirect("/register")
    if username.lower() in ("admin", "system"):
        flash("That username is reserved")
        return redirect("/register")
    if db.execute(
        "SELECT 1 FROM users WHERE username = ? COLLATE NOCASE", [username]
    ).fetchone():
        flash("That username is taken")
        return redirect("/register")
    db.execute(
        "INSERT INTO users (username, password) VALUES (?, ?)",
        (username, password),
    )
    welcome_email(username)
    flash("Account created. Please log in.")
    return redirect("/login")


@app.route("/api/mail", methods=["POST"])
def api_mail():
    username = current_user()
    if not username:
        return {"error": "Not signed in"}, 401
    recipient = (request.form.get("to") or "").split("@")[0].strip()
    if not recipient:
        return {"error": "Enter a recipient"}, 400
    if not db.execute("SELECT 1 FROM users WHERE username = ?", [recipient]).fetchone():
        return {"error": f"No account for {recipient}@pwm.college"}, 400
    db.execute(
        "INSERT INTO emails (sender, sender_addr, recipient, subject, body) VALUES (?, ?, ?, ?, ?)",
        (
            username,
            address(username),
            recipient,
            request.form.get("subject", ""),
            request.form.get("body", ""),
        ),
    )
    return {"ok": True}


@app.route("/api/mail/<int:mail_id>", methods=["DELETE"])
def api_mail_delete(mail_id):
    username = current_user()
    if not username:
        return ("", 401)
    db.execute(
        "DELETE FROM emails WHERE rowid = ? AND (recipient = ? OR sender = ?)",
        [mail_id, username, username],
    )
    return ("", 204)


@app.route("/")
def inbox_page():
    username = current_user()
    if not username:
        return redirect("/login")
    inbox = db.execute(
        "SELECT rowid, * FROM emails WHERE recipient = ? ORDER BY rowid DESC",
        [username],
    ).fetchall()
    sent = db.execute(
        "SELECT rowid, * FROM emails WHERE sender = ? ORDER BY rowid DESC",
        [username],
    ).fetchall()
    return render_template(
        "index.html",
        username=username,
        me=address(username),
        inbox=inbox,
        sent=sent,
        panels={e["rowid"]: e for e in list(inbox) + list(sent)}.values(),
        base="",
    )


