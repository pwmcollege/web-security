#!/usr/bin/env python

import glob
import json
import os
import pty
import select
import signal
import struct
import threading
import time
import fcntl
import termios
from collections import deque

import requests
from flask import Flask, Response, render_template
from flask_sock import Sock

app = Flask(__name__)
sock = Sock(app)
signal.signal(signal.SIGCHLD, signal.SIG_IGN)

session = requests.Session()
session.mount("https://", requests.adapters.HTTPAdapter(
    pool_connections=2, pool_maxsize=4, max_retries=0))

state = {
    "up": True,
    "latency": None,
    "fails": 0,
    "history": deque([True] * 40, maxlen=40),
    "flag": None,
}

WEB_TTYS = set()
TIOCGPTN = 0x80045430

CLEAR = "\033[2J\033[H"


def read_flag():
    with open("/flag") as f:
        return f.read().strip()


def list_ttys():
    seen, out = set(), []
    for p in glob.glob("/dev/pts/[0-9]*") + glob.glob("/dev/tty[0-9]*"):
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def broadcast_flag(flag):
    message = f"The server is down! Your flag is: {flag}\n"
    for tty in list_ttys():
        if tty in WEB_TTYS:
            continue
        try:
            with open(tty, "w", buffering=1, errors="ignore") as f:
                f.write(CLEAR)
                f.write(message)
        except Exception:
            pass


def probe_loop():
    down_ticks = 0
    while True:
        t0 = time.monotonic()
        try:
            r = session.get(
                "https://victim.internal:443/health",
                timeout=(1, 2),
                verify="/etc/ssl/certs/internal.cert.pem",
            )
            up = r.status_code == 200
        except requests.RequestException:
            up = False
        dt = int((time.monotonic() - t0) * 1000)

        state["up"] = up
        state["latency"] = dt if up else None
        state["history"].append(up)
        state["fails"] = 0 if up else state["fails"] + 1

        if state["fails"] >= 5:
            if state["flag"] is None:
                state["flag"] = read_flag()
            if down_ticks % 10 == 0:
                broadcast_flag(state["flag"])
            down_ticks += 1
        else:
            down_ticks = 0
            if up:
                state["flag"] = None

        time.sleep(1)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/events")
def events():
    def stream():
        while True:
            payload = {
                "up": state["up"],
                "latency": state["latency"],
                "fails": state["fails"],
                "history": list(state["history"]),
                "flag": state["flag"] if state["fails"] >= 5 else None,
            }
            yield f"data: {json.dumps(payload)}\n\n"
            time.sleep(1)
    return Response(stream(), mimetype="text/event-stream")


def set_winsize(fd, rows, cols):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


@sock.route("/pty")
def pty_socket(ws):
    pid, fd = pty.fork()
    if pid == 0:
        for sig in (signal.SIGCHLD, signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP):
            signal.signal(sig, signal.SIG_DFL)
        os.environ["TERM"] = "xterm-256color"
        os.environ["HOME"] = "/home/hacker"
        os.environ["PS1"] = r"\[\e[38;5;35m\]hacker\[\e[0m\]:\w\$ "
        os.closerange(3, 64)
        try:
            os.setgroups([1000])
        except OSError:
            pass
        os.setresgid(1000, 1000, 1000)
        os.setresuid(1000, 1000, 1000)
        try:
            os.chdir(os.environ["HOME"])
        except OSError:
            os.chdir("/tmp")
        os.execvp("/bin/bash", ["/bin/bash", "--noprofile", "--norc", "-i"])
        return

    web_tty = None
    try:
        ptn = struct.unpack("i", fcntl.ioctl(fd, TIOCGPTN, struct.pack("i", 0)))[0]
        web_tty = f"/dev/pts/{ptn}"
        WEB_TTYS.add(web_tty)
    except OSError:
        pass

    alive = threading.Event()
    alive.set()

    def pty_to_ws():
        while alive.is_set():
            r, _, _ = select.select([fd], [], [], 0.2)
            if fd not in r:
                continue
            try:
                data = os.read(fd, 4096)
            except OSError:
                break
            if not data:
                break
            try:
                ws.send(data.decode("utf-8", "replace"))
            except Exception:
                break
        alive.clear()

    threading.Thread(target=pty_to_ws, daemon=True).start()

    try:
        while alive.is_set():
            msg = ws.receive()
            if msg is None:
                break
            try:
                m = json.loads(msg)
            except (ValueError, TypeError):
                continue
            if m.get("t") == "in":
                os.write(fd, m["d"].encode())
            elif m.get("t") == "resize":
                set_winsize(fd, int(m["rows"]), int(m["cols"]))
    finally:
        alive.clear()
        WEB_TTYS.discard(web_tty)
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass


threading.Thread(target=probe_loop, daemon=True).start()

app.config["SERVER_NAME"] = "challenge.internal"
app.run(
    "challenge.internal",
    443,
    threaded=True,
    ssl_context=(
        "/etc/ssl/certs/internal.cert.pem",
        "/etc/ssl/private/internal.key.pem",
    ),
)
