#!/usr/bin/env python

import glob
import json
import threading
import time
from collections import deque

import requests
from flask import Flask, Response, render_template

app = Flask(__name__)

session = requests.Session()
session.mount(
    "https://",
    requests.adapters.HTTPAdapter(pool_connections=2, pool_maxsize=4, max_retries=0),
)

state = {
    "up": None,
    "fails": 0,
    "history": deque(maxlen=90),
    "flag": None,
}

CLEAR = "\033[2J\033[H"


def read_flag():
    with open("/flag") as f:
        return f.read().strip()


def list_ttys():
    seen, out = set(), []
    for p in glob.glob("/dev/pts/[0-9]*") + glob.glob("/dev/tty[0-9]*"):
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def broadcast_flag(flag):
    message = f"The server is down! Your flag is: {flag}\n"
    for tty in list_ttys():
        try:
            with open(tty, "w", buffering=1, errors="ignore") as f:
                f.write(CLEAR)
                f.write(message)
        except Exception:
            pass


def probe_loop():
    broadcast_ticks = 0
    while True:
        try:
            r = session.get(
                "https://victim.internal:443/health",
                timeout=(1, 2),
                verify="/etc/ssl/certs/internal.cert.pem",
            )
            up = r.status_code == 200
        except requests.RequestException:
            up = False
        state["up"] = up
        state["fails"] = 0 if up else state["fails"] + 1
        state["history"].append(
            {"up": up, "checked_at": time.time(), "fails": state["fails"]}
        )

        if state["flag"] is not None:
            if broadcast_ticks % 10 == 0:
                broadcast_flag(state["flag"])
            broadcast_ticks += 1
        elif state["fails"] >= 5:
            state["flag"] = read_flag()
            broadcast_flag(state["flag"])
            broadcast_ticks = 1

        time.sleep(1)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/events")
def events():
    def stream():
        while True:
            payload = {
                "up": state["up"],
                "fails": state["fails"],
                "history": list(state["history"]),
                "flag": state["flag"],
            }
            yield f"data: {json.dumps(payload)}\n\n"
            time.sleep(1)

    return Response(stream(), mimetype="text/event-stream")


threading.Thread(target=probe_loop, daemon=True).start()

app.config["SERVER_NAME"] = "challenge.internal"
app.run(
    "challenge.internal",
    443,
    threaded=True,
    ssl_context=(
        "/etc/ssl/certs/internal.cert.pem",
        "/etc/ssl/private/internal.key.pem",
    ),
)
